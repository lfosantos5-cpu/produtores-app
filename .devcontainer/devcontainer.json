{\n  \"name\": \"Expo React Native Dev\",\n  \"image\": \"mcr.microsoft.com/devcontainers/javascript-node:18-bookworm\",\n  \"features\": {\n    \"ghcr.io/devcontainers/features/node:1\": {\n      \"version\": \"18\"\n    }\n  },\n  \"forwardPorts\": [8081, 19000, 19001, 19002],\n  \"customizations\": {\n    \"vscode\": {\n      \"settings\": {\n        \"terminal.integrated.defaultProfile.linux\": \"bash\"\n      },\n      \"extensions\": [\n        \"esbenp.prettier-vscode\",\n        \"dbaeumer.vscode-eslint\"\n      ]\n    }\n  },\n  \"postCreateCommand\": \"npm install -g expo-cli && yarn install || npm install\",\n  \"remoteUser\": \"node\"\n}